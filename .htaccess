Options -Indexes
RewriteEngine On

# Toda la API va a api.php (que parsea el URI internamente)
RewriteRule ^api/(.*)$          api.php [L]

# Formulario de preinscripción
RewriteRule ^formulario/?$      inscripcion.php [L]

# Página de resultados por equipo (QR)
RewriteRule ^resultados/(.+)$   resultados.php?id=$1 [L,QSA]
