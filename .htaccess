Options -Indexes
RewriteEngine On

# Redirige todos los endpoints de la API a api.php
RewriteRule ^api/datos$                    api.php [L]
RewriteRule ^api/equipos$                  api.php [L]
RewriteRule ^api/equipos/borrar$           api.php [L]
RewriteRule ^api/puntuaciones$             api.php [L]
RewriteRule ^api/puntuaciones/borrar$      api.php [L]
RewriteRule ^api/mi-ip$                    api.php [L]
RewriteRule ^api/logo$                     api.php [L]

# Página de resultados por equipo (QR)
RewriteRule ^resultados/(.+)$              resultados.php?id=$1 [L,QSA]
